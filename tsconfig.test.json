{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".tmp-test",
    "rootDir": "."
  },
  "include": [
    "src/lib/vpay.ts",
    "src/lib/vpayPricing.ts",
    "src/lib/vpayWebhookHandler.ts",
    "src/lib/catalog.ts",
    "src/lib/domains.ts",
    "tests/**/*.ts"
  ]
}
